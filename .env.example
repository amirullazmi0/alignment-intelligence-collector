# =============================================================================
# Database collector
# Terpisah dari database Alignment Intelligence. Schema-nya dimiliki Prisma
# (prisma/schema.prisma); saat runtime dibaca langsung lewat asyncpg.
# Jalankan `yarn db:deploy` sekali sebelum service pertama kali dijalankan.
# =============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_jdih_collector?schema=public"

# =============================================================================
# Sumber JDIHN
# =============================================================================
JDIHN_BASE_URL=https://www.jdihn.go.id
# Jeda antar permintaan. Jangan diturunkan di bawah 2 detik: WAF JDIHN memutus
# koneksi kalau diberondong.
REQUEST_DELAY_SECONDS=2
HTTP_TIMEOUT_SECONDS=30

# =============================================================================
# Tujuan unggah
# =============================================================================
ALIGNMENT_API_BASE_URL=https://alignment-intelligence-nest.apps.arulize.com
ALIGNMENT_EMAIL=
ALIGNMENT_PASSWORD=

# =============================================================================
# Batas per run
# =============================================================================
MAX_UPLOADS_PER_RUN=25
MAX_PDF_BYTES=52428800
DOWNLOAD_DIR=downloads

# =============================================================================
# HTTP service
# COLLECTOR_INTERNAL_TOKEN harus sama dengan milik alignment-intelligence-cron.
# Boleh dikosongkan untuk pengembangan lokal; kalau kosong, autentikasi dilewati.
# =============================================================================
COLLECTOR_INTERNAL_TOKEN=
COLLECTOR_SERVICE_HOST=127.0.0.1
COLLECTOR_SERVICE_PORT=5003

# =============================================================================
# Tema bawaan untuk CLI
# Hanya dipakai `yarn backfill` tanpa opsi --ministry. Run dari dashboard selalu
# menentukan kementeriannya sendiri, jadi nilai di sini diabaikan.
# =============================================================================
COLLECTOR_TOPIC=pendidikan
COLLECTOR_KEYWORDS=pendidikan,sekolah,guru
COLLECTOR_EXCLUDE_KEYWORDS=

# =============================================================================
# Log
# =============================================================================
LOG_LEVEL=INFO
LOG_COLOR=auto
