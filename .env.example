# Hanya nilai yang memang harus diisi. Sisanya sudah punya bawaan yang masuk akal di
# app/config.py -- tulis di sini hanya kalau memang mau ditimpa.

# Database collector. Schema-nya dimiliki Prisma; jalankan `yarn db:deploy` sekali
# sebelum service pertama kali dijalankan.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/db_jdih_collector?schema=public"

# Akun yang dipakai collector untuk mengunggah ke Knowledge Library.
ALIGNMENT_EMAIL=
ALIGNMENT_PASSWORD=

# Harus sama dengan milik alignment-intelligence-cron. Kalau dikosongkan, autentikasi
# dilewati -- boleh untuk lokal, jangan untuk deploy.
COLLECTOR_INTERNAL_TOKEN=

# Kata yang membatalkan sebuah kandidat walau keyword-nya cocok. Berlaku untuk semua run,
# termasuk yang dijalankan cron. Pakai seperlunya: pencocokannya substring, sehingga kata
# umum seperti "manusia" ikut membuang seluruh arsip Kementerian Hak Asasi Manusia.
COLLECTOR_EXCLUDE_KEYWORDS=

# Alamat API Alignment Intelligence. Wajib diisi: alamat deployment sengaja tidak punya
# nilai bawaan di kode, supaya konfigurasi yang keliru gagal keras alih-alih diam-diam
# memanggil server yang salah. Dipakai untuk mengunggah dokumen sekaligus memverifikasi
# login dashboard.
ALIGNMENT_API_BASE_URL=

# Sisanya memakai bawaan; buka baris yang perlu saja.
# JDIHN_BASE_URL=https://www.jdihn.go.id
# REQUEST_DELAY_SECONDS=2        # jangan di bawah 2: WAF JDIHN memutus koneksi
# HTTP_TIMEOUT_SECONDS=30
# MAX_UPLOADS_PER_RUN=25
# MAX_PDF_BYTES=52428800
# DOWNLOAD_DIR=downloads
# COLLECTOR_SERVICE_HOST=127.0.0.1
# COLLECTOR_SERVICE_PORT=5003
# LOG_LEVEL=INFO
# LOG_COLOR=auto
